PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/asirs_db
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=8h
GEMINI_API_KEY=your_google_gemini_api_key
ENCRYPTION_KEY=exactly_32_characters_here____
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
ADMIN_EMAIL=admin@institution.edu
CLIENT_URL=http://localhost:3000
UNIVERSITY_EMAIL_PATTERN=^[^\s@]+@[a-zA-Z0-9.-]+\.edu(\.[a-z]{2})?$
SEED_ADMIN_EMAIL=admin@institution.edu
SEED_ADMIN_PASSWORD=ChangeThis@123
NODE_ENV=development
